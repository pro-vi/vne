{
  "name": "vne",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "vite build",
    "install:local": "npm run build && cargo install --path src-tauri --bin vne --locked --force --features custom-protocol",
    "preview": "vite preview --host 127.0.0.1",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "tauri": "tauri"
  },
  "dependencies": {
    "@lucide/svelte": "1.17.0",
    "@tauri-apps/api": "2.11.0",
    "@tauri-apps/plugin-dialog": "2.7.1",
    "svelte": "5.56.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.1.2",
    "@tauri-apps/cli": "2.11.2",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "25.9.1",
    "svelte-check": "4.4.8",
    "typescript": "6.0.3",
    "vite": "^8.2.2",
    "vitest": "4.1.11"
  }
}
